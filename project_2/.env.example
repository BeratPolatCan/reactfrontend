# Backend'in adresi (sonunda / OLMADAN).
#
# Bu değişken İSTEĞE BAĞLIDIR:
#   - Boş bırakılırsa kod http://localhost:8080 kullanır (yerel backend).
#   - Farklı bir backend'e bağlanmak istersen burada belirt:
#       VITE_API_BASE_URL=http://localhost:9090
#
# NOT: VITE_ önekli değişkenler tarayıcı paketine GÖMÜLÜR ve herkese görünür.
# Buraya asla gizli anahtar/parola yazma.
VITE_API_BASE_URL=
